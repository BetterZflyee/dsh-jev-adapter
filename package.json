{
  "name": "dsh-jev-adapter",
  "version": "0.1.0",
  "description": "Use the Jev (System One) decision-model paradigm with any OpenAI-compatible LLM — no TypeSafe key required. Registers a jev_decide tool on DeepSeek Harness (dsh).",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "jev",
    "typesafe",
    "system-one",
    "decision-model",
    "adapter",
    "openai-compatible"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./adapter": "./lib/adapter.js"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0 || >=0.1.0-rc.0"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetterZflyee/dsh-jev-adapter.git"
  },
  "author": "BetterZflyee",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
